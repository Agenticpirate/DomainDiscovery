# Domain Search API Configuration
# Copy this file to .env.local and add your API keys

# ============================================================================
# Domain Availability APIs (Choose one or more)
# ============================================================================

# Option 1: Domainr API (Recommended - Fast and reliable)
# Sign up at: https://domainr.build/
# DOMAINR_API_KEY=your_domainr_api_key_here

# Option 2: RapidAPI (Budget-friendly option)
# Sign up at: https://rapidapi.com/
# Subscribe to "Domain Availability Checker"
# RAPIDAPI_KEY=your_rapidapi_key_here

# Option 3: WHOIS-based checking (Free but slower)
# Set to 'true' to enable WHOIS checking
# USE_WHOIS_CHECK=false

# ============================================================================
# AI Domain Generation (Optional)
# ============================================================================

# ============================================================================
# AI Domain Assistant — no paid LLM / registrar API keys
# ============================================================================
# Availability = Instant Domain Search MCP (same free stack as main DomainDiscovery site).
# ADA_USE_INSTANT_DOMAIN_MCP=true   # default ON — set false only to force RDAP-only
#
# Ranking / chat intake = local rules (no OpenAI/xAI needed).
#
# Optional paid LLM chat (OFF by default):
# ADA_ALLOW_PAID_LLM=true
#
# Anthropic Claude (native Messages API — preferred):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# Or OpenAI-compatible (MiniMax / xAI):
# XAI_API_KEY=…   # or MINIMAX_API_KEY / OPENAI_API_KEY
# XAI_BASE_URL=https://api.minimaxi.com/v1
# XAI_MODEL=MiniMax-Text-01
#
# Optional: require for agent clients of /api/ada/chat and MCP
# AGENT_API_KEY=your_shared_secret

# ============================================================================
# Additional APIs (Optional)
# ============================================================================

# WHOIS API (for detailed domain information)
# WHOIS_API_KEY=your_whois_api_key_here

# Domain Value API (for domain appraisal)
# DOMAIN_VALUE_API_KEY=your_value_api_key_here

# ============================================================================
# Notes
# ============================================================================
# 
# 1. The app works with MOCK DATA by default (no API keys needed for testing)
# 2. Add API keys to enable real domain checking
# 3. Never commit .env.local to version control
# 4. Restart your dev server after adding keys
# 5. See API-INTEGRATION-GUIDE.md for detailed setup instructions
