{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domains-discovery",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    // Lets the Worker read the /_data/*.json files (src/lib/dataFiles.workers.ts).
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Serve .html files as-is (no /x.html -> /x redirect) so verification files work.
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
