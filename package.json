{
  "name": "domains-discovery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 5001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "prices:unstoppable": "python3 scripts/refresh_unstoppable_prices.py",
    "prices:tld-list": "python3 scripts/refresh_tld_prices.py --all --workers 2 --delay 0.7 --resume --checkpoint-every 40",
    "prices:tld-list:full": "python3 scripts/refresh_tld_prices.py --all --workers 2 --delay 0.7 --resume --checkpoint-every 40",
    "prices:weekly": "python3 scripts/weekly_price_verify.py --batch-size 100 --workers 2",
    "prices:firecrawl": "python3 scripts/firecrawl_tld_fallback.py --from-failed --limit 20",
    "tlds:about": "python3 scripts/scrape_tld_about.py --priority-only --wiki",
    "tlds:about:all": "python3 scripts/scrape_tld_about.py --all --resume --delay 0.35",
    "tlds:about:wiki": "python3 scripts/scrape_tld_about.py --wiki-only --delay 0.2",
    "tlds:about:meta": "python3 scripts/enrich_tld_about_meta.py",
    "seo:index-health": "node scripts/seo-index-health.mjs",
    "seo:index-health:prod": "node scripts/seo-index-health.mjs --base https://www.domainsdiscovery.com",
    "learn:expand": "node scripts/expand-learn-phase-d.mjs",
    "learn:import-seo": "node scripts/import-seo-articles.mjs",
    "learn:schedule-seo": "node scripts/schedule-seo-articles.mjs --per-day 3",
    "learn:schedule-seo:status": "node scripts/seo-publish-status.mjs",
    "mcp:server": "node scripts/mcp-domaindiscovery.mjs",
    "mcp:stdio": "npx --yes tsx scripts/mcp-domaindiscovery-entry.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "agent:prod-smoke": "node scripts/agent-prod-smoke.mjs",
    "ada:eval": "node scripts/ada-eval-shortlist.mjs",
    "ada:eval:offline": "node scripts/ada-eval-shortlist.mjs --skip-live"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@octokit/rest": "^22.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "jspdf": "^4.0.0",
    "next": "14.2.35",
    "node-fetch": "^3.3.2",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "fast-check": "^4.5.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
