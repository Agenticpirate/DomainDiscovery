# Public site origin (emails, sitemap, social share / Open Graph cards)
# Use your real HTTPS domain in production so X/LinkedIn can fetch WHOIS card images.
# Localhost links will never show image previews on social networks.
# Prefer the canonical host users actually land on (apex may 307 → www).
NEXT_PUBLIC_BASE_URL=https://www.domainsdiscovery.com
NEXT_PUBLIC_APP_URL=http://localhost:5001

# Optional: Google Search Console HTML-tag verification token (Phase F ops)
# Search Console → property → Settings → Ownership verification → HTML tag
# Paste only the content= value, not the full meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=googleXXXXXXXXXXXXXXXX

# Free email delivery (Resend free tier — recommended)
# https://resend.com — 100 emails/day free
RESEND_API_KEY=
RESEND_FROM_EMAIL=DomainDiscovery Alerts <onboarding@resend.dev>

# Optional: custom webhook (Zapier / Make / n8n free tiers)
EMAIL_WEBHOOK_URL=

# Protect the daily watch checker (POST /api/domains/watch/check)
CRON_SECRET=change-me-to-a-long-random-string

# Optional: GoDaddy for premium/enrichment checks
# https://developer.godaddy.com/
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Optional: Redis for distributed agent scale (rate limits, jobs, concurrency)
# Without this, scale features fall back to in-process memory (single instance only)
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=

# Scale foundation (see docs/agent/SCALE.md)
# RATE_LIMIT_LIGHT_RPM=120
# RATE_LIMIT_HEAVY_RPM=20
# RATE_LIMIT_IP_LIGHT_RPM=60
# RATE_LIMIT_IP_HEAVY_RPM=10
# ADA_MAX_HEAVY_CONCURRENT=32
# ADA_MAX_HEAVY_CONCURRENT_GLOBAL=128
# ADA_JOB_TTL_SECONDS=3600
# Multi-agent keys: key:agentId:heavyRpm[:lightRpm]
# AGENT_API_KEYS=sk_acme:acme:40:200,sk_beta:beta:15
# AGENT_API_KEYS_JSON={"sk_acme":{"id":"acme","heavyRpm":40,"lightRpm":200}}


# Optional feature flags
ENABLE_MCP_SEARCH=false
ENABLE_PREMIUM_ENRICHMENT=false

# Optional CORS (comma-separated origins). Empty = same-origin / defaults.
CORS_ALLOWED_ORIGINS=

# Optional: Firecrawl backup for TLD-List when direct scrape is blocked
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# AI Domain Assistant — paid LLM (server only)
# Anthropic (preferred):
#   ADA_ALLOW_PAID_LLM=true
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-4-5
# OpenAI-compatible (MiniMax / xAI):
#   XAI_API_KEY=...  XAI_BASE_URL=https://api.minimaxi.com/v1  XAI_MODEL=MiniMax-Text-01
ADA_ALLOW_PAID_LLM=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=
# Optional bearer for public MCP/agent API (leave empty for private/dev)
AGENT_API_KEY=
# Force auth even if key unset fails closed (recommended in production).
# Unset + NODE_ENV=production → also requires key. Set false for open demos.
# AGENT_REQUIRE_AUTH=true
ENABLE_AGENT=true
ENABLE_MCP_SERVER=true

# L3 registrar mutations (BYOK only — never ADA billing). Default OFF.
# When true, porkbun / namecheap / cloudflare / namesilo / dynadot adapters
# can register + set DNS after x-ada-human-confirm. Always start with dryRun:true.
ADA_ENABLE_REGISTRAR_MUTATIONS=false
# Namecheap sandbox + ClientIp for API whitelist
# NAMECHEAP_SANDBOX=true
# NAMECHEAP_CLIENT_IP=1.2.3.4

# --- Production agent checklist (see docs/agent/PRODUCTION.md + SCALE.md) ---
# AGENT_API_KEY=<openssl rand -hex 32>
# AGENT_REQUIRE_AUTH=true
# REDIS_URL=redis://...
# NEXT_PUBLIC_BASE_URL=https://www.domainsdiscovery.com
# NEXT_PUBLIC_ADA_URL=https://www.aidomainassistant.com
# CORS_ALLOWED_ORIGINS=https://www.aidomainassistant.com,https://www.domainsdiscovery.com
# npm run agent:prod-smoke


# AI Domain Assistant product (aidomainassistant.com)
NEXT_PUBLIC_ADA_HOST=www.aidomainassistant.com
NEXT_PUBLIC_ADA_URL=https://www.aidomainassistant.com
# Agent API base (DomainDiscovery). Leave empty to use same origin in monorepo.
NEXT_PUBLIC_DD_API_BASE=
