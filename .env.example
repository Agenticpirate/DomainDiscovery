# DomainsDiscovery.com Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DomainsDiscovery.com

# ===========================================
# External API Keys (Domain Services)
# ===========================================
# Domain availability checking API
DOMAIN_API_KEY=
DOMAIN_API_URL=

# WHOIS lookup service
WHOIS_API_KEY=
WHOIS_API_URL=

# ===========================================
# Affiliate Registrar Configuration
# ===========================================
# GoDaddy Affiliate
GODADDY_AFFILIATE_ID=
GODADDY_API_KEY=

# Namecheap Affiliate
NAMECHEAP_AFFILIATE_ID=
NAMECHEAP_API_KEY=

# Porkbun Affiliate
PORKBUN_AFFILIATE_ID=

# ===========================================
# Analytics & Tracking
# ===========================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Plausible Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ===========================================
# Rate Limiting Configuration
# ===========================================
# Requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Bulk check rate limit (requests per minute)
RATE_LIMIT_BULK_REQUESTS_PER_MINUTE=10

# ===========================================
# Cache Configuration
# ===========================================
# Domain availability cache TTL (seconds)
DOMAIN_CACHE_TTL=300

# WHOIS cache TTL (seconds)
WHOIS_CACHE_TTL=3600

# ===========================================
# Security
# ===========================================
# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Content Security Policy nonce (auto-generated if not set)
CSP_NONCE_SECRET=

# ===========================================
# Feature Flags
# ===========================================
# Enable/disable specific features
FEATURE_BULK_CHECKER=true
FEATURE_WHOIS_LOOKUP=true
FEATURE_DOMAIN_APPRAISAL=true
FEATURE_EXPIRED_DOMAINS=true
